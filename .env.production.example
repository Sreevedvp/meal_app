# Generate real random secrets with scripts/init-production-env.py.
PUBLIC_HOST=meals.example.com
TLS_EMAIL=admin@example.com
OIDC_ISSUER_URL=https://identity.example.com
OIDC_CLIENT_ID=replace-with-provider-client-id
OIDC_CLIENT_SECRET=replace-with-provider-client-secret
ALLOWED_EMAIL_DOMAINS=example.com
PROXY_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
OAUTH_COOKIE_SECRET=replace-with-base64-encoded-32-random-bytes
DB_ADMIN_PASSWORD=replace-with-random-url-safe-password
APP_DB_PASSWORD=replace-with-a-different-random-url-safe-password
# Explicit opt-in to deploying the labelled demo dataset; this is NOT data verification.
ALLOW_DEMO_DATA=false
APP_IMAGE_TAG=local
